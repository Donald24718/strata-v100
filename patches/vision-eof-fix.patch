# Vision embedding EOF fix
# serve/server.py deferred reading each embedding file until after the whole encode loop. The vision cache is an LRU of 64 entries, so a request carrying more images than the cache holds had an earlier file evicted before it was read, and the client saw an EOF mid-request. Each embedding is now read immediately after its own encode.
# Base: Niko1221/Strata v0.1.30 (MIT, Copyright (c) 2026 Niko1221 and the Strata contributors)
# Apply from the source root:  patch -p1 < this-file

--- a/serve/server.py
+++ b/serve/server.py
@@ -903,8 +903,18 @@
             # run on the GPU at the same time - an encode during a running request left that request stuck at
             # "reading the prompt" with CPU and GPU busy, for good (reproduced).  So encoding takes its turn in the
             # same FIFO as the requests.
+            combined = self.vision.dir / f"req-{uuid.uuid4().hex[:12]}.sve"
+            encoded = []
             with self.fifo:
-                encoded = [self.vision.encode(src) for src in images]
+                with open(combined, "wb") as f:
+                    # Each embedding file is read out right after its encode: a later encode may evict it from the
+                    # vision cache (LRU, 64 entries), so deferring the read to the end of the loop breaks requests
+                    # that carry more images than the cache holds (2026-10-01: a 65-image request lost a file to
+                    # eviction and the client saw an EOF mid-request).
+                    for src in images:
+                        path, n = self.vision.encode(src)
+                        f.write(path.read_bytes())
+                        encoded.append(n)
             # one <|image_pad|> per image -> one per image token.  Only the markers the template writes for an image
             # (right after <|vision_start|>) are images: the same text inside a message (an agent reading these docs,
             # #150) is kept as plain text, or it took an image's place and the counts no longer matched.
