{
  "_comment": "Working 262K configuration on one 16 GB V100. Paths are placeholders. Key points for 16 GB: experts stay in RAM (mmap), only a bounded KV window is resident, and the vision encoder costs ~1.3 GiB of VRAM which shrinks the expert cache.",
  "exe": "/path/to/strata-v100/build/strata",
  "args": [
    "--pack", "/path/to/packs/iq3s",
    "--native", "/path/to/model-shard-00001-of-00002.gguf",
    "--ple-gguf", "/path/to/model-shard-00002-of-00002.gguf",
    "--ple-io", "ram",
    "--expert-profile", "/path/to/expert-profile.bin",
    "--expert-cache", "auto",
    "--prefill", "auto",
    "--spec", "4", "--spec-min-p", "0.5",
    "--max-context", "262144",
    "--kv", "fp16", "--kv-resident", "32768",
    "--vision", "--vram-reserve-mib", "700",
    "--mtp", "/path/to/mtp-bf16/rt",
    "--pool-workers", "22"
  ],
  "port": 8080,
  "gpu": [1]
}
